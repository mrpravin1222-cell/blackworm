rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default catch-all rule
    match /{document=**} {
      allow read, write: if true;
    }

    // Central App & Global State Data
    match /app/{docId} {
      allow read, write: if true;
    }

    match /globalData/{docId} {
      allow read, write: if true;
    }

    // User Accounts & Authentication Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Dealer Applications & Registrations
    match /dealerApplications/{dealerId} {
      allow read, write: if true;
    }

    // Sales Orders & Invoices
    match /dealerOrders/{orderId} {
      allow read, write: if true;
    }

    // Payment Collections & Receipts
    match /dealerCollections/{collectionId} {
      allow read, write: if true;
    }

    // Travel Sheets & Allowance Claims
    match /travelSheets/{sheetId} {
      allow read, write: if true;
    }

    match /travelExpenses/{expenseId} {
      allow read, write: if true;
    }

    // Daily Activities, Farmer Meetings & Site Visits
    match /dailyActivities/{activityId} {
      allow read, write: if true;
    }

    // Farmers, Plots & Schedules
    match /farmers/{farmerId} {
      allow read, write: if true;
    }

    match /plots/{plotId} {
      allow read, write: if true;
    }

    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Target Sheets & Achievements
    match /targetSheets/{targetId} {
      allow read, write: if true;
    }

    // Product Price List
    match /priceList/{itemId} {
      allow read, write: if true;
    }

    // Promotional Schemes
    match /schemes/{schemeId} {
      allow read, write: if true;
    }

    // Company Master & Banking Details
    match /companyDetails/{docId} {
      allow read, write: if true;
    }

    // System Settings & Logs
    match /appSettings/{docId} {
      allow read, write: if true;
    }

    match /activityLogs/{logId} {
      allow read, write: if true;
    }
  }
}
