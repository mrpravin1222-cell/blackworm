rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // GLOBAL HELPERS
    // ---------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'SUPER_ADMIN';
    }
    
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        getUserData().role == 'ADMIN'
      );
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ---------------------------------------------------------
    // ENTITY VALIDATION HELPERS
    // ---------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'loginId', 'role']) &&
             data.id is string &&
             data.loginId is string &&
             data.role in ['SUPER_ADMIN', 'ADMIN', 'USER', 'asm', 'field-officer', 'sales-officer', 'sr', 'sales-executive', 'dealer'] &&
             (!('email' in data) || data.email is string) &&
             (!('fullName' in data) || data.fullName is string) &&
             (!('designation' in data) || data.designation is string) &&
             (!('isActive' in data) || data.isActive is bool);
    }

    function isValidPriceListItem(data) {
      return data.keys().hasAll(['id', 'nameMr']) &&
             data.id is string &&
             data.nameMr is string;
    }

    function isValidDealerApplication(data) {
      return data.keys().hasAll(['id', 'firmName', 'status']) &&
             data.id is string &&
             data.firmName is string &&
             data.status in ['pending', 'approved', 'rejected', 'under_review', 'cancelled'];
    }

    // ---------------------------------------------------------
    // COLLECTION RULES
    // ---------------------------------------------------------

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isSignedIn();
      
      allow create: if isAdmin() && isValidUser(incoming()) && incoming().id == userId;
      
      allow update: if (
        // Admin can update anything except ID
        (isAdmin() && isValidUser(incoming()) && incoming().id == userId && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'name', 'designation', 'role', 'loginId', 'password', 'phone', 'email', 'village', 
          'address', 'bloodGroup', 'territory', 'isActive', 'managedBy', 'allowedTabs', 'updatedAt'
        ])) ||
        // User can update their own non-sensitive info
        (request.auth.uid == userId && incoming().id == userId && incoming().role == existing().role &&
         incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'name', 'phone', 'email', 'village', 'address', 'bloodGroup', 'updatedAt']))
      );
      
      allow delete: if isSuperAdmin();
    }

    // PRICE LIST COLLECTION
    match /priceList/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // DEALER APPLICATIONS
    match /dealerApplications/{appId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidDealerApplication(incoming());
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // TARGETS
    match /targets/{targetId} {
      allow read: if isSignedIn() && (isAdmin() || existing().executiveId == request.auth.uid);
      allow write: if isAdmin();
    }

    // TRAVEL EXPENSES
    match /travelExpenses/{expenseId} {
      allow read: if isSignedIn() && (isAdmin() || existing().employeeId == request.auth.uid);
      allow create: if isSignedIn() && incoming().employeeId == request.auth.uid;
      allow update: if isAdmin() || (existing().employeeId == request.auth.uid && existing().status == 'pending');
    }

    // DAILY ACTIVITIES
    match /dailyActivities/{activityId} {
      allow read: if isSignedIn() && (isAdmin() || existing().employeeId == request.auth.uid);
      allow create: if isSignedIn() && incoming().employeeId == request.auth.uid;
      allow update: if isAdmin() || (existing().employeeId == request.auth.uid);
    }

    // CONFIG
    match /config/company {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
