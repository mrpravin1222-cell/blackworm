{
  "entities": {
    "DealerApplication": {
      "title": "Dealer Application",
      "description": "Information about a dealership application",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "center": { "type": "string" },
        "shopOpeningDate": { "type": "string" },
        "dealerCode": { "type": "string" },
        "firmName": { "type": "string" },
        "proprietorName": { "type": "string" },
        "contactNumber": { "type": "string" },
        "email": { "type": "string" },
        "aadhaarNo": { "type": "string" },
        "district": { "type": "string" },
        "panNo": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "gstNo": { "type": "string" },
        "pinCode": { "type": "string" },
        "village": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "cancelled"] },
        "applicationDate": { "type": "string" },
        "mobile": { "type": "string" },
        "applicantPhotoUrl": { "type": "string" }
      },
      "required": ["id", "firmName"]
    },
    "User": {
      "title": "App User",
      "description": "Authorized system user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loginId": { "type": "string" },
        "password": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff"] }
      },
      "required": ["id", "loginId", "password"]
    }
  },
  "firestore": {
    "/dealerApplications/{appId}": {
      "schema": "DealerApplication",
      "description": "Dealership records accessible to authorized users"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and credentials"
    }
  }
}
